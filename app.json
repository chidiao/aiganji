{
  "expo": {
    "name": "爱赶集",
    "slug": "aiganji",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aiganji",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.aiganji.app",
      "infoPlist": {
        "NSCameraUsageDescription": "用于拍摄并发送聊天图片和视频",
        "NSPhotoLibraryUsageDescription": "用于选择聊天图片和视频",
        "NSPhotoLibraryAddUsageDescription": "用于保存聊天图片",
        "NSMicrophoneUsageDescription": "用于录制聊天语音",
        "NSDocumentsFolderUsageDescription": "用于选择聊天文件"
      }
    },
    "android": {
      "package": "com.aiganji.app",
      "adaptiveIcon": {
        "backgroundColor": "#2E6FD6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "VIBRATE",
        "WAKE_LOCK"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E6FD6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "react-native-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c343711a-ef68-41e6-9fa3-7db8178c709c"
      }
    },
    "owner": "chidiao"
  }
}
